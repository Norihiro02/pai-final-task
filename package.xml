<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pai_final_task</name>
  <version>0.1.0</version>
  <description>
    Physical AI final task: a TurtleBot3 explores a Gazebo arena and visits
    three colored targets in a fixed order, guided only by YOLO-World
    (pretrained, zero-shot) object detection on the live camera feed.
  </description>
  <maintainer email="norihiro.vsq@gmail.com">norihiro</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
